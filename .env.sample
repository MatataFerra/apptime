# This file is only a sample.
# Please create a .env file and fill it with the following variables

DATABASE_URL= #we use turso or sqlite service
DEV_MODE=true
GATEWAY_PASSWORD=
GATEWAY_SECRET=
GATEWAY_URL= #we use a service to create admin users
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
NEXT_PUBLIC_API_MOCKING="enabled"
NEXT_PUBLIC_SHOW_DEVTOOLS=true  # this is for react-query devtools
NEXT_PUBLIC_TURSO_DATABASE_URL= # again the same db url
NEXT_PUBLIC_URL=http://localhost:3000
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000/
STAGING=true # this mode is not implemented, it was, but at the same time it was not convenient
TURSO_AUTH_TOKEN=
TURSO_ON=false # in dev mode is useful to avoid request to the cloud db, when it is false the app use local sqlite db

# mailing service
RESEND_API_KEY=
RESEND_SENDER=
RESEND_SUBJECT=

# ABN Lookup (Australian Business Register). Free GUID: https://abr.business.gov.au/Tools/WebServices
ABR_GUID=
# NZBN register (New Zealand). Free key: https://portal.api.business.govt.nz/api/nzbn
NZBN_API_KEY=
# EU VAT numbers go through VIES, which needs no key.

# Just for testing
TEST_BOOLEAN_TO_BE_TRUE=true
TEST_BOOLEAN_TO_BE_FALSE=false
