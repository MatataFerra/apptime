This file is only a sample. Please create a .env file and fill it with the following variables

DATABASE_URL=
TURSO_AUTH_TOKEN=
NEXT_PUBLIC_TURSO_DATABASE_URL=
NEXT_PUBLIC_API_MOCKING=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
JWT_SECRET=
NEXT_PUBLIC_SHOW_DEVTOOLS=true
STAGING=false
TURSO_ON=false

# Just for testing
TEST_BOOLEAN_TO_BE_TRUE=true
TEST_BOOLEAN_TO_BE_FALSE=false
