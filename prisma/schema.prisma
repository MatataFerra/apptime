// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// TAX CODES
// 0 - M
// 1 - CAE
// 2 - NONE

// TYPE SHIFTS
// TRACK
// FAST
// PRODUCTION

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./apptime.db"
}

model Shift {
  id         Int          @id @default(autoincrement())
  userId     String?      @unique
  production Production[]
  hourly     Hourly[]
  user       User?        @relation(fields: [userId], references: [id])
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  emailVerified      DateTime?
  image              String?
  name               String
  password           String?
  type_account       String               @default("CREDENTIALS")
  role               String               @default("USER")
  online             Boolean              @default(false)
  formCompleted      Boolean              @default(false)
  isActive           Boolean              @default(true)
  shifts             Shift?
  profile            Profile?
  config             Config?
  passwordAttemps    PasswordAttemps?
  passwordResetToken PasswordResetToken[]
}

model Profile {
  id        Int     @id @default(autoincrement())
  firstName String
  lastName  String?
  address   String?
  city      String?
  country   String?
  user      User?   @relation(fields: [userId], references: [id])
  userId    String? @unique
}

model Production {
  id                  Int            @id @default(autoincrement())
  startDate           String
  endDate             String?
  amount              Float?
  isPublicHoliday     Boolean        @default(false)
  publicHolidayWorked Boolean        @default(false)
  isClosed            Boolean        @default(false)
  notes               String?
  itemValue           Float?
  itemQuantity        Float?
  holidayPay          Boolean
  holidayPayRate      Float?
  shiftId             Int?
  taxes               Tax[]
  contributions       Contribution[]
  shift               Shift?         @relation(fields: [shiftId], references: [id])
}

model Hourly {
  id                  Int            @id @default(autoincrement())
  startDate           String
  endDate             String?
  amount              Float?
  isPublicHoliday     Boolean        @default(false)
  publicHolidayWorked Boolean        @default(false)
  isClosed            Boolean        @default(false)
  notes               String?
  hourValue           Float
  holidayPay          Boolean
  holidayPayRate      Float?
  unpaidBreaks        Float?
  shiftId             Int?
  taxes               Tax[]
  contributions       Contribution[]
  shift               Shift?         @relation(fields: [shiftId], references: [id])
}

model Tax {
  id          Int          @id @default(autoincrement())
  name        String
  value       Float
  description String?
  production  Production[]
  hourly      Hourly[]
}

model Contribution {
  id          Int          @id @default(autoincrement())
  name        String
  value       Float
  description String?
  production  Production[]
  hourly      Hourly[]
}

model Config {
  id           Int     @id @default(autoincrement())
  weekStartsOn String  @default("monday")
  userId       String? @unique
  user         User?   @relation(fields: [userId], references: [id])
}

model PasswordAttemps {
  id           Int       @id @default(autoincrement())
  maxAttemps   Int       @default(5)
  renewAttemps DateTime? @default(now())
  User         User?     @relation(fields: [userId], references: [id])
  userId       String?   @unique
}

model WaitingListDesktop {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  createdAt DateTime  @default(now())
  resetAt   DateTime?
  emailId   String?

  user   User   @relation(fields: [userId], references: [id])
  userId String 
}
