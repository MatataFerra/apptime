// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shift {
  id        Int     @id @default(autoincrement())
  startDate String
  endDate   String?
  amount    Float?
  isHoliday Boolean @default(false)
  isClosed  Boolean @default(false)
  notes     String?
  User      User?   @relation(fields: [userId], references: [id])
  userId    String?
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  image         String?
  name          String
  password      String?
  type_account  Type      @default(CREDENTIALS)
  online        Boolean   @default(false)
  formCompleted Boolean   @default(false)
  shifts        Shift[]
  profile       Profile?
}

model Profile {
  id                 Int     @id @default(autoincrement())
  hourlyRate         Float
  startHour          Float
  endHour            Float
  nightShift         Boolean
  extraNightShiftPay Float?
  holidayPay         Boolean
  holidayPayRate     Float?
  unpaidBreaks       Float?
  User               User?   @relation(fields: [userId], references: [id])
  userId             String? @unique
}

enum Type {
  OAUTH
  CREDENTIALS
}
