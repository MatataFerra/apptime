// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// TAX CODES
// 0 - M
// 1 - CAE
// 2 - NONE

// TYPE SHIFTS
// TRACK
// FAST
// PRODUCTION

generator client {
  provider = "prisma-client-js"
}

// The URL lives in prisma.config.ts (CLI) and prisma/client.ts (app).
datasource db {
  provider = "sqlite"
}

model Shift {
  id         Int          @id @default(autoincrement())
  userId     String?      @unique
  production Production[]
  hourly     Hourly[]
  user       User?        @relation(fields: [userId], references: [id])
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  /// Better Auth: true once the email is confirmed (it was a date before).
  emailVerified      Boolean        @default(false)
  image              String?
  name               String
  type_account       String         @default("CREDENTIALS")
  role               String         @default("USER")
  online             Boolean        @default(false)
  formCompleted      Boolean        @default(false)
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt
  /// Login methods (password, Google), managed by Better Auth.
  accounts           Account[]
  sessions           Session[]
  shifts             Shift?
  profile            Profile?
  config             Config?
  taxes              Tax[]
  contributions      Contribution[]
  employers          Employer[]
}

/// Better Auth: one row per signed-in device.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Better Auth: how a user signs in. The password hash lives here
/// (providerId "credential"); Google sign-ins are providerId "google".
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// Better Auth: short-lived tokens (password reset, email verification).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model Profile {
  id        Int     @id @default(autoincrement())
  firstName String
  lastName  String?
  address   String?
  city      String?
  country   String?
  user      User?   @relation(fields: [userId], references: [id])
  userId    String? @unique
}

/// A place the user works for. Its details are what visa and tax forms ask
/// for (e.g. proof of the 88 days of specified work in Australia).
model Employer {
  id              Int      @id @default(autoincrement())
  name            String
  /// Business or tax number: ABN, CUIT, Steuernummer…
  taxId           String?
  address         String?
  city            String?
  postcode        String?
  country         String?
  industry        String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  /// Prefilled on new shifts for this employer.
  defaultRate     Float?
  /// ISO 4217 code. Null: the user's default currency (Config.currency).
  defaultCurrency String?
  notes           String?
  /// Hidden from the list and pickers; kept for the shifts that use it.
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Production {
  id                  Int            @id @default(autoincrement())
  name                String?
  startDate           String
  endDate             String?
  amount              Float?
  isPublicHoliday     Boolean        @default(false)
  publicHolidayWorked Boolean        @default(false)
  isClosed            Boolean        @default(false)
  notes               String?
  itemValue           Float?
  itemQuantity        Float?
  /// ISO 4217 code. Null: the user's default currency (Config.currency).
  currency            String?
  shiftId             Int?
  taxes               Tax[]
  contributions       Contribution[]
  shift               Shift?         @relation(fields: [shiftId], references: [id])
}

model Hourly {
  id                  Int            @id @default(autoincrement())
  name                String?
  startDate           String
  endDate             String?
  amount              Float?
  isPublicHoliday     Boolean        @default(false)
  publicHolidayWorked Boolean        @default(false)
  isClosed            Boolean        @default(false)
  notes               String?
  hourValue           Float
  unpaidBreaks        Float?
  /// ISO 4217 code. Null: the user's default currency (Config.currency).
  currency            String?
  /// Where the shift was logged: "track" (live clock) or "fast" (Fast charge). Null: before this existed.
  source              String?
  shiftId             Int?
  taxes               Tax[]
  contributions       Contribution[]
  shift               Shift?         @relation(fields: [shiftId], references: [id])
}

model Tax {
  id          Int          @id @default(autoincrement())
  name        String
  value       Float
  description String?
  /// Hidden from the picker; shifts that use it keep it.
  archived    Boolean      @default(false)
  /// Each user has their own taxes (they used to be shared by name).
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  production  Production[]
  hourly      Hourly[]

  @@index([userId])
}

model Contribution {
  id          Int          @id @default(autoincrement())
  name        String
  value       Float
  description String?
  /// Hidden from the picker; shifts that use it keep it.
  archived    Boolean      @default(false)
  /// Each user has their own taxes (they used to be shared by name).
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  production  Production[]
  hourly      Hourly[]

  @@index([userId])
}

model Config {
  id           Int     @id @default(autoincrement())
  weekStartsOn String  @default("monday")
  /// Default currency for new shifts and for shifts saved before currencies existed.
  currency     String  @default("USD")
  /// Defaults that prefill Track, Fast charge and Estimate.
  hourValue    Float?
  unpaidBreaks Float?
  holidayPay   Float   @default(8)
  /// "system" | "light" | "dark"
  theme        String  @default("system")
  userId       String? @unique
  user         User?   @relation(fields: [userId], references: [id])
}


model WaitingListDesktop {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

