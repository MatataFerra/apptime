// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// TAX CODES
// 0 - M
// 1 - CAE
// 2 - NONE

// TYPE SHIFTS
// TRACK
// FAST
// PRODUCTION

generator client {
  provider = "prisma-client-js"
}

// The URL lives in prisma.config.ts (CLI) and prisma/client.ts (app).
datasource db {
  provider = "sqlite"
}

model Shift {
  id         Int          @id @default(autoincrement())
  userId     String?      @unique
  production Production[]
  hourly     Hourly[]
  user       User?        @relation(fields: [userId], references: [id])
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  emailVerified      DateTime?
  image              String?
  name               String
  password           String?
  type_account       String               @default("CREDENTIALS")
  role               String               @default("USER")
  online             Boolean              @default(false)
  formCompleted      Boolean              @default(false)
  isActive           Boolean              @default(true)
  shifts             Shift?
  profile            Profile?
  config             Config?
  passwordAttemps    PasswordAttemps?
  passwordResetToken PasswordResetToken[]
  taxes              Tax[]
  contributions      Contribution[]
}

model Profile {
  id        Int     @id @default(autoincrement())
  firstName String
  lastName  String?
  address   String?
  city      String?
  country   String?
  user      User?   @relation(fields: [userId], references: [id])
  userId    String? @unique
}

model Production {
  id                  Int            @id @default(autoincrement())
  name                String?
  startDate           String
  endDate             String?
  amount              Float?
  isPublicHoliday     Boolean        @default(false)
  publicHolidayWorked Boolean        @default(false)
  isClosed            Boolean        @default(false)
  notes               String?
  itemValue           Float?
  itemQuantity        Float?
  /// ISO 4217 code. Null: the user's default currency (Config.currency).
  currency            String?
  shiftId             Int?
  taxes               Tax[]
  contributions       Contribution[]
  shift               Shift?         @relation(fields: [shiftId], references: [id])
}

model Hourly {
  id                  Int            @id @default(autoincrement())
  name                String?
  startDate           String
  endDate             String?
  amount              Float?
  isPublicHoliday     Boolean        @default(false)
  publicHolidayWorked Boolean        @default(false)
  isClosed            Boolean        @default(false)
  notes               String?
  hourValue           Float
  unpaidBreaks        Float?
  /// ISO 4217 code. Null: the user's default currency (Config.currency).
  currency            String?
  /// Where the shift was logged: "track" (live clock) or "fast" (Fast charge). Null: before this existed.
  source              String?
  shiftId             Int?
  taxes               Tax[]
  contributions       Contribution[]
  shift               Shift?         @relation(fields: [shiftId], references: [id])
}

model Tax {
  id          Int          @id @default(autoincrement())
  name        String
  value       Float
  description String?
  /// Hidden from the picker; shifts that use it keep it.
  archived    Boolean      @default(false)
  /// Each user has their own taxes (they used to be shared by name).
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  production  Production[]
  hourly      Hourly[]

  @@index([userId])
}

model Contribution {
  id          Int          @id @default(autoincrement())
  name        String
  value       Float
  description String?
  /// Hidden from the picker; shifts that use it keep it.
  archived    Boolean      @default(false)
  /// Each user has their own taxes (they used to be shared by name).
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  production  Production[]
  hourly      Hourly[]

  @@index([userId])
}

model Config {
  id           Int     @id @default(autoincrement())
  weekStartsOn String  @default("monday")
  /// Default currency for new shifts and for shifts saved before currencies existed.
  currency     String  @default("USD")
  /// Defaults that prefill Track, Fast charge and Estimate.
  hourValue    Float?
  unpaidBreaks Float?
  holidayPay   Float   @default(8)
  /// "system" | "light" | "dark"
  theme        String  @default("system")
  userId       String? @unique
  user         User?   @relation(fields: [userId], references: [id])
}

model PasswordAttemps {
  id           Int       @id @default(autoincrement())
  maxAttemps   Int       @default(5)
  renewAttemps DateTime? @default(now())
  User         User?     @relation(fields: [userId], references: [id])
  userId       String?   @unique
}

model WaitingListDesktop {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  createdAt DateTime  @default(now())
  resetAt   DateTime?
  emailId   String?

  user   User   @relation(fields: [userId], references: [id])
  userId String 
}
