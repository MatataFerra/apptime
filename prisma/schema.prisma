// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// TAX CODES
// 0 - M
// 1 - CAE
// 2 - NONE

// TYPE SHIFTS
// TRACK
// FAST
// PRODUCTION

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./apptime.db"
}

model Shift {
  id         Int          @id @default(autoincrement())
  userId     String?      @unique
  Production Production[]
  Hourly     Hourly[]
  User       User?        @relation(fields: [userId], references: [id])
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  emailVerified   DateTime?
  image           String?
  name            String
  password        String?
  type_account    String           @default("CREDENTIALS")
  role            String           @default("USER")
  online          Boolean          @default(false)
  formCompleted   Boolean          @default(false)
  isActive        Boolean          @default(true)
  shifts          Shift?
  profile         Profile?
  config          Config?
  passwordAttemps PasswordAttemps?
}

model Profile {
  id        Int     @id @default(autoincrement())
  firstName String
  lastName  String?
  address   String?
  city      String?
  country   String?
  User      User?   @relation(fields: [userId], references: [id])
  userId    String? @unique
}

model Production {
  id                  Int            @id @default(autoincrement())
  startDate           String
  endDate             String?
  amount              Float?
  isPublicHoliday     Boolean        @default(false)
  publicHolidayWorked Boolean        @default(false)
  isClosed            Boolean        @default(false)
  notes               String?
  itemValue           Float?
  itemQuantity        Float?
  holidayPay          Boolean
  holidayPayRate      Float?
  taxCode             Int?           @default(0)
  shiftId             Int?
  taxes               Tax[]
  contributions       Contribution[]
  Shift               Shift?         @relation(fields: [shiftId], references: [id])
}

model Hourly {
  id                  Int            @id @default(autoincrement())
  startDate           String
  endDate             String?
  amount              Float?
  isPublicHoliday     Boolean        @default(false)
  publicHolidayWorked Boolean        @default(false)
  isClosed            Boolean        @default(false)
  notes               String?
  hourValue           Float
  holidayPay          Boolean
  holidayPayRate      Float?
  unpaidBreaks        Float?
  taxCode             Int?           @default(0)
  shiftId             Int?
  taxes               Tax[]
  contributions       Contribution[]
  Shift               Shift?         @relation(fields: [shiftId], references: [id])
}

model Tax {
  id           Int         @id @default(autoincrement())
  name         String
  value        Float
  description  String?
  hourlyId     Int?
  productionId Int?
  Production   Production? @relation(fields: [productionId], references: [id])
  Hourly       Hourly?     @relation(fields: [hourlyId], references: [id])
}

model Contribution {
  id           Int         @id @default(autoincrement())
  name         String
  value        Float
  description  String?
  hourlyId     Int?
  productionId Int?
  Production   Production? @relation(fields: [productionId], references: [id])
  Hourly       Hourly?     @relation(fields: [hourlyId], references: [id])
}

model Config {
  id           Int     @id @default(autoincrement())
  weekStartsOn String  @default("MONDAY")
  User         User?   @relation(fields: [userId], references: [id])
  userId       String? @unique
}

model PasswordAttemps {
  id           Int       @id @default(autoincrement())
  maxAttemps   Int       @default(5)
  renewAttemps DateTime? @default(now())
  User         User?     @relation(fields: [userId], references: [id])
  userId       String?   @unique
}

model WaitingListDesktop {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}
