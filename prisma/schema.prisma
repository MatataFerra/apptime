// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./apptime.db"
}

model Shift {
  id                  Int     @id @default(autoincrement())
  startDate           String
  endDate             String?
  amount              Float?
  isPublicHoliday     Boolean @default(false)
  publicHolidayWorked Boolean @default(false)
  isClosed            Boolean @default(false)
  notes               String?
  User                User?   @relation(fields: [userId], references: [id])
  userId              String?
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  emailVerified   DateTime?
  image           String?
  name            String
  password        String?
  type_account    String             @default("CREDENTIALS")
  role            String             @default("USER")
  online          Boolean          @default(false)
  formCompleted   Boolean          @default(false)
  isActive        Boolean          @default(true)
  shifts          Shift[]
  profile         Profile?
  passwordAttemps PasswordAttemps?
}

model Profile {
  id                 Int     @id @default(autoincrement())
  hourlyRate         Float
  startHour          Float
  endHour            Float
  nightShift         Boolean
  extraNightShiftPay Float?
  holidayPay         Boolean
  holidayPayRate     Float?
  unpaidBreaks       Float?
  User               User?   @relation(fields: [userId], references: [id])
  userId             String? @unique
}

model PasswordAttemps {
  id           Int       @id @default(autoincrement())
  maxAttemps   Int       @default(5)
  renewAttemps DateTime? @default(now())
  User         User?     @relation(fields: [userId], references: [id])
  userId       String?   @unique
}

model WaitingListDesktop {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  createdAt DateTime @default(now())
}

