{
  "name": "app-time-yarn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prettier:fix": "yarn prettier . --write",
    "eslint:fix": "yarn eslint . --fix",
    "ts-lint": "tsc --noEmit --incremental --watch",
    "coverage": "vitest --coverage",
    "compose": "docker compose -f \"docker-compose.yml\" up -d --build --remove-orphans",
    "prisma:migrate": "bash ./scripts/prisma-migrate.sh",
    "prisma:push": "dotenv -e .env.development -- prisma db push",
    "prisma:seed": "dotenv -e .env.development -- prisma db seed",
    "prisma:studio": "dotenv -e .env.development -- prisma studio",
    "test": "dotenv -e .env.development -- vitest",
    "test:ci": "vitest",
    "test:e2e": "dotenv -e .env.testing -- playwright test",
    "test:seed": "dotenv -e .env.testing -- prisma db seed",
    "test:studio": "dotenv -e .env.testing -- prisma studio",
    "curl": "bash ./scripts/curl.sh",
    "port": "bash ./scripts/port.sh"
  },
  "dependencies": {
    "@auth/prisma-adapter": "1.0.0",
    "@formatjs/intl-localematcher": "^0.4.0",
    "@hookform/resolvers": "^3.3.0",
    "@prisma/client": "4.13.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-query": "4.36.1",
    "autoprefixer": "10.4.16",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^3.0.6",
    "eslint": "8.56.0",
    "eslint-config-next": "14.0.4",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "negotiator": "^0.6.3",
    "next": "14.0.0",
    "next-auth": "4.24.5",
    "next-intl": "3.4.0",
    "postcss": "8.4.32",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.45.4",
    "tailwind-merge": "2.2.0",
    "tailwindcss": "3.4.0",
    "tailwindcss-animate": "1.0.7",
    "typescript": "^5.2.2",
    "usehooks-ts": "^2.9.1",
    "zod": "3.22.4",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.38.1",
    "@tanstack/eslint-plugin-query": "4.36.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.4.3",
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/lodash": "^4.14.194",
    "@types/negotiator": "^0.6.1",
    "@types/react": "^18.2.28",
    "@types/react-dom": "18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-simple-import-sort": "10.0.0",
    "jsdom": "^23.0.1",
    "msw": "^1.3.2",
    "prettier": "^3.0.1",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "prisma": "4.13.0",
    "ts-node": "^10.9.1",
    "vitest": "^1.1.0",
    "vitest-fetch-mock": "0.2.2",
    "vitest-mock-extended": "^1.3.1"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": "please-use-yarn",
    "yarn": "1.22.19"
  }
}
