{
  "name": "app-time-yarn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.development next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "dotenv -e .env.development vitest",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage",
    "compose": "docker compose -f \"docker-compose.yml\" up -d --build --remove-orphans",
    "prisma:push": "dotenv -e .env.development -- prisma db push",
    "prisma:seed": "dotenv -e .env.development -- prisma db seed",
    "prisma:studio": "dotenv -e .env.development -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^4.13.0",
    "@types/node": "18.16.0",
    "@types/react": "18.0.38",
    "@types/react-dom": "18.0.11",
    "autoprefixer": "10.4.14",
    "bcryptjs": "^2.4.3",
    "eslint": "8.39.0",
    "eslint-config-next": "^13.4.1",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "next": "^13.4.1",
    "next-swagger-doc": "^0.3.6",
    "postcss": "8.4.23",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "swagger-ui-react": "^4.18.3",
    "tailwindcss": "3.3.1",
    "typescript": "5.0.4",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.194",
    "@types/swagger-ui-react": "^4.18.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-c8": "^0.30.1",
    "jsdom": "^21.1.1",
    "node-mocks-http": "^1.12.2",
    "prisma": "^4.13.0",
    "ts-node": "^10.9.1",
    "vitest": "^0.31.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": "please-use-yarn",
    "yarn": "1.22.19"
  }
}
