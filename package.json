{
  "name": "app-time-yarn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.development next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "dotenv -e .env.development -- jest -i --watch",
    "test:ci": "jest",
    "coverage": "jest --coverage",
    "compose": "docker compose -f \"docker-compose.yml\" up -d --build --remove-orphans",
    "prisma:migrate": "yarn scripts:access && ./scripts/prisma-migrate.sh",
    "prisma:seed": "dotenv -e .env.development -- prisma db seed",
    "prisma:studio": "dotenv -e .env.development -- prisma studio",
    "curl": "yarn scripts:access && ./scripts/curl.sh",
    "scripts:access": "chmod +x ./access.sh && ./access.sh"
  },
  "dependencies": {
    "@prisma/client": "^4.13.0",
    "@types/react": "18.0.38",
    "@types/react-dom": "18.0.11",
    "autoprefixer": "10.4.14",
    "bcryptjs": "^2.4.3",
    "eslint": "8.39.0",
    "eslint-config-next": "^13.4.1",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "next": "^13.4.1",
    "next-swagger-doc": "^0.3.6",
    "postcss": "8.4.23",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "swagger-ui-react": "^4.18.3",
    "tailwindcss": "3.3.1",
    "typescript": "5.0.4",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.1",
    "@types/lodash": "^4.14.194",
    "@types/swagger-ui-react": "^4.18.0",
    "jest": "^29.5.0",
    "jest-mock-extended": "^3.0.4",
    "jsdom": "^21.1.1",
    "msw": "^1.2.1",
    "prisma": "^4.13.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": "please-use-yarn",
    "yarn": "1.22.19"
  }
}
