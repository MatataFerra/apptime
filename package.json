{
  "name": "app-time-yarn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prettier:fix": "yarn prettier . --write",
    "eslint:fix": "yarn eslint . --fix",
    "test": "dotenv -e .env.development -- jest -i --watch",
    "test:ci": "jest",
    "test:e2e": "playwright test",
    "playwright:report": "playwright show-report",
    "e2e:one": "bash ./scripts/e2e.sh",
    "ts-lint": "tsc --noEmit --incremental --watch",
    "coverage": "jest --coverage",
    "compose": "docker compose -f \"docker-compose.yml\" up -d --build --remove-orphans",
    "prisma:migrate": "bash ./scripts/prisma-migrate.sh",
    "prisma:push": "dotenv -e .env.development -- prisma db push",
    "prisma:seed": "dotenv -e .env.development -- prisma db seed",
    "prisma:studio": "dotenv -e .env.development -- prisma studio",
    "curl": "bash ./scripts/curl.sh",
    "port": "bash ./scripts/port.sh"
  },
  "dependencies": {
    "@auth/prisma-adapter": "1.0.0",
    "@formatjs/intl-localematcher": "^0.4.0",
    "@hookform/resolvers": "^3.3.0",
    "@prisma/client": "4.13.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-query": "^4.33.0",
    "autoprefixer": "10.4.14",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "eslint": "8.39.0",
    "eslint-config-next": "^13.4.1",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "negotiator": "^0.6.3",
    "next": "^13.5.4",
    "next-auth": "4.22.1",
    "next-intl": "^2.19.1",
    "next-swagger-doc": "^0.3.6",
    "postcss": "8.4.23",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.45.4",
    "swagger-ui-react": "^4.18.3",
    "tailwind-merge": "^1.14.0",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.2.2",
    "zod": "3.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.38.1",
    "@tanstack/eslint-plugin-query": "^4.32.5",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.4.3",
    "@types/bcryptjs": "^2.4.2",
    "@types/jest": "^29.5.1",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/lodash": "^4.14.194",
    "@types/negotiator": "^0.6.1",
    "@types/react": "^18.2.28",
    "@types/react-dom": "18.0.11",
    "@types/swagger-ui-react": "^4.18.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.6.2",
    "jest-fetch-mock": "3.0.3",
    "jest-mock-extended": "^3.0.4",
    "jsdom": "^21.1.1",
    "msw": "^1.2.1",
    "prettier": "^3.0.1",
    "prettier-plugin-tailwindcss": "^0.4.1",
    "prisma": "4.13.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": "please-use-yarn",
    "yarn": "1.22.19"
  }
}
