{
  "name": "app-time",
  "version": "0.9.6",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prettier:fix": "pnpm prettier . --write",
    "eslint:fix": "pnpm eslint . --fix",
    "ts-lint": "tsc --noEmit --incremental --watch",
    "coverage": "vitest --coverage",
    "compose": "docker compose -f \"docker-compose.yml\" up -d --build --remove-orphans",
    "prisma:migrate": "bash ./scripts/prisma-migrate.sh",
    "prisma:push": "dotenv -e .env.local -- prisma db push",
    "prisma:seed": "dotenv -e .env.local -- prisma db seed",
    "prisma:studio": "dotenv -e .env.local -- prisma studio",
    "turso:shell": "bash ./scripts/turso.sh",
    "test": "dotenv -e .env.local -- vitest",
    "test:ci": "vitest",
    "test:e2e": "dotenv -e .env.testing -- playwright test",
    "test:seed": "dotenv -e .env.testing -- prisma db seed",
    "test:studio": "dotenv -e .env.testing -- prisma studio",
    "curl": "bash ./scripts/curl.sh",
    "port": "bash ./scripts/port.sh"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.4.2",
    "@hookform/resolvers": "^3.3.4",
    "@libsql/client": "^0.5.6",
    "@next/bundle-analyzer": "^14.2.3",
    "@prisma/adapter-libsql": "^5.13.0",
    "@prisma/client": "5.7.1",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-query": "5.17.1",
    "@vercel/speed-insights": "^1.0.10",
    "autoprefixer": "10.4.16",
    "bcryptjs": "^2.4.3",
    "chroma-js": "^2.4.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "8.0.2",
    "eslint": "9.1.1",
    "eslint-config-next": "14.0.4",
    "lodash": "^4.17.21",
    "negotiator": "^0.6.3",
    "next": "14.2.3",
    "next-auth": "4.24.7",
    "next-intl": "3.4.0",
    "postcss": "8.4.32",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.51.3",
    "recharts": "^2.12.6",
    "sharp": "^0.33.2",
    "tailwind-merge": "2.2.0",
    "tailwindcss": "3.4.0",
    "tailwindcss-animate": "1.0.7",
    "typescript": "^5.4.5",
    "usehooks-ts": "^3.1.0",
    "zod": "3.23.5",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.1",
    "@tanstack/eslint-plugin-query": "5.32.1",
    "@tanstack/react-query-devtools": "^5.32.1",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "14.1.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/chroma-js": "^2.4.4",
    "@types/lodash": "^4.17.0",
    "@types/negotiator": "^0.6.3",
    "@types/node": "^20.12.8",
    "@types/react": "^18.3.1",
    "@types/react-dom": "18.2.18",
    "@vitejs/plugin-react": "4.2.1",
    "@vitest/coverage-v8": "^1.5.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-simple-import-sort": "10.0.0",
    "jsdom": "^23.2.0",
    "msw": "^1.3.3",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "prisma": "5.7.1",
    "ts-node": "^10.9.2",
    "vitest": "^1.5.3",
    "vitest-fetch-mock": "0.2.2",
    "vitest-mock-extended": "^1.3.1"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
