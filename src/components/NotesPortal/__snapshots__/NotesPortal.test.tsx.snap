// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Portal > renders children when isOn is false 1`] = `
<body
  style="overflow: auto;"
>
  <div />
  <nav
    class="[&>section]:animate-fade-down"
    id="notes"
  />
</body>
`;

exports[`Portal > renders children when isOn is false 2`] = `<div />`;

exports[`Portal > renders children when isOn is true 1`] = `
<body
  style="overflow: hidden;"
>
  <div />
  <nav
    class="[&>section]:animate-fade-down"
    id="notes"
  >
    <section>
      Portal
    </section>
  </nav>
</body>
`;

exports[`Portal > renders children when isOn is true 2`] = `<div />`;
