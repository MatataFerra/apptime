{
  "definition": {
    "openapi": "3.0.0",
    "info": {
      "title": "App Time API",
      "version": "1.0",
      "description": "Api for manage data in the app time "
    },
    "paths": {
      "/hello": {
        "get": {
          "summary": "Returns a list of users.",
          "description": "This resource represents an individual user in the system. Each user is identified by a numeric `id`.",
          "tags": ["User"],
          "responses": {
            "200": {
              "description": "A JSON array of user names with their shifts",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      }
    },
    "servers": [
      {
        "url": "http://localhost:3000/api",
        "description": "Development server"
      }
    ],
    "security": [],
    "components": {
      "schemas": {
        "User": {
          "type": "object",
          "required": ["email", "password"],
          "properties": {
            "id": {
              "type": "number",
              "readOnly": true
            },
            "endHour": {
              "type": "number"
            },
            "extraNightShiftPay": {
              "type": "number"
            },
            "formCompleted": {
              "type": "boolean"
            },
            "holidayPay": {
              "type": "boolean"
            },
            "holidayPayRate": {
              "type": "number"
            },
            "hourlyRate": {
              "type": "number"
            },
            "lastname": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "nightShift": {
              "type": "boolean"
            },
            "online": {
              "type": "boolean"
            },
            "password": {
              "type": "string",
              "format": "password"
            },
            "email": {
              "type": "string",
              "format": "email"
            }
          }
        },
        "Shift": {
          "type": "object",
          "properties": {
            "id": {
              "type": "number",
              "readOnly": true
            },
            "amount": {
              "type": "number"
            },
            "end": {
              "type": "string"
            },
            "endDate": {
              "type": "string"
            },
            "isClosed": {
              "type": "boolean"
            },
            "isHoliday": {
              "type": "boolean"
            },
            "notes": {
              "type": "string"
            },
            "start": {
              "type": "string"
            },
            "startDate": {
              "type": "string"
            },
            "userId": {
              "type": "number",
              "readOnly": true
            }
          }
        }
      }
    },

    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
